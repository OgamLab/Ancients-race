<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<Operation Class="PatchOperationSequence">
		<operations>
			<!-- Удаляем старые теги безопасно (не упадёт, если тега нет) -->
			<li Class="PatchOperationRemove">
				<success>Always</success>
				<xpath>Defs/PawnKindDef[defName="GFSoldier"]/weaponTags</xpath>
			</li>
			<li Class="PatchOperationRemove">
				<success>Always</success>
				<xpath>Defs/PawnKindDef[defName="GFSoldier"]/apparelRequired</xpath>
			</li>
			<li Class="PatchOperationRemove">
				<success>Always</success>
				<xpath>Defs/PawnKindDef[defName="GFSoldier"]/apparelTags</xpath>
			</li>

			<!-- Добавляем новые -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/PawnKindDef[defName="GFSoldier"]</xpath>
				<value>
					<weaponTags>
						<li>REAWGun</li>
					</weaponTags>
					<apparelRequired>
						<li>REAW_AncientCombatArmor</li>
						<li>REAW_AncientCombatHelmet</li>
					</apparelRequired>
					<apparelTags>
						<li>REAWArmor</li>
					</apparelTags>
				</value>
			</li>
		</operations>
	</Operation>
	
	
	<Operation Class="PatchOperationSequence">
		<operations>
			<!-- Удаляем старые теги безопасно (не упадёт, если тега нет) -->
			<li Class="PatchOperationRemove">
				<success>Always</success>
				<xpath>Defs/PawnKindDef[defName="GFWarrior"]/weaponTags</xpath>
			</li>
			<li Class="PatchOperationRemove">
				<success>Always</success>
				<xpath>Defs/PawnKindDef[defName="GFWarrior"]/apparelRequired</xpath>
			</li>
			<li Class="PatchOperationRemove">
				<success>Always</success>
				<xpath>Defs/PawnKindDef[defName="GFWarrior"]/apparelTags</xpath>
			</li>

			<!-- Добавляем новые -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/PawnKindDef[defName="GFWarrior"]</xpath>
				<value>
					<weaponTags>
						<li>REAWMelee</li>
					</weaponTags>
					<apparelRequired>
						<li>REAW_AncientStrikerArmor</li>
						<li>REAW_AncientStrikerHelmet</li>
					</apparelRequired>
					<apparelTags>
						<li>REAWArmor</li>
					</apparelTags>
				</value>
			</li>
		</operations>
	</Operation>
	
	
	<Operation Class="PatchOperationSequence">
		<operations>
			<!-- Удаляем старые теги безопасно (не упадёт, если тега нет) -->
			<li Class="PatchOperationRemove">
				<success>Always</success>
				<xpath>Defs/PawnKindDef[defName="GFMarauder"]/weaponTags</xpath>
			</li>
			<li Class="PatchOperationRemove">
				<success>Always</success>
				<xpath>Defs/PawnKindDef[defName="GFMarauder"]/apparelRequired</xpath>
			</li>
			<li Class="PatchOperationRemove">
				<success>Always</success>
				<xpath>Defs/PawnKindDef[defName="GFMarauder"]/apparelTags</xpath>
			</li>

			<!-- Добавляем новые -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/PawnKindDef[defName="GFMarauder"]</xpath>
				<value>
					<weaponTags>
						<li>REAWWeapon</li>
					</weaponTags>
					<apparelTags>
						<li>REAWArmor</li>
					</apparelTags>
					<specificApparelRequirements>
						<li>
							<bodyPartGroup>FullHead</bodyPartGroup>
							<alternateTagChoices>
								<li>
									<tag>REAWArmor</tag>
									<chance>1</chance>
								</li>
							</alternateTagChoices>
						</li>
						<li>
							<bodyPartGroup>Torso</bodyPartGroup>
						</li>
					</specificApparelRequirements>
				</value>
			</li>
		</operations>
	</Operation>
</Patch>